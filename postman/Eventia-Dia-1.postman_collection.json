{
  "info": {
    "name": "Eventia API — Día 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Lecturas públicas",
      "item": [
        {
          "name": "Categorías",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/categories"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eventos (catálogo completo)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/events"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "if (pm.response.code === 200) {",
                  "    const events = pm.response.json();",
                  "    const event = events.find(event => event.availableSpots > 0) || events[0];",
                  "    const full = events.find(event => event.availableSpots === 0);",
                  "    pm.collectionVariables.set('eventId', event ? String(event.id) : '');",
                  "    pm.collectionVariables.set('fullEventId', full ? String(full.id) : '');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Lugares",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/venues"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "if (pm.response.code === 200) {",
                  "    const venue = pm.response.json()[0];",
                  "    pm.collectionVariables.set('venueId', venue ? String(venue.id) : '');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle de evento (sin token)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/events/{{eventId}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Omite isAttending', () => pm.expect(pm.response.json()).not.to.have.property('isAttending'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle de lugar",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/venues/{{venueId}}"
          },
          "response": []
        },
        {
          "name": "Eventos del lugar",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/venues/{{venueId}}/events"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cuenta de curso",
      "item": [
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{courseEmail}}\",\n  \"password\": \"{{coursePassword}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.unset('token');",
                  "if (pm.response.code === 200) {",
                  "    const token = pm.response.json().token;",
                  "    pm.test('Devuelve token', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "    if (typeof token === 'string' && token) pm.collectionVariables.set('token', token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Usuario autenticado",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/me"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle de evento",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/events/{{eventId}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Incluye isAttending booleano', () => pm.expect(pm.response.json().isAttending).to.be.a('boolean'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Inscripciones — solo cuenta dedicada",
      "item": [
        {
          "name": "Inscribirse",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendanceToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/events/{{eventId}}/attendance"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!(pm.variables.get('attendanceToken') && pm.variables.get('eventId'))) {",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Mis inscripciones",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendanceToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/me/attendances"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!(pm.variables.get('attendanceToken'))) {",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancelar inscripción",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendanceToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/events/{{eventId}}/attendance"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!(pm.variables.get('attendanceToken') && pm.variables.get('eventId'))) {",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Inscribirse a evento sin cupos (409)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendanceToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/events/{{fullEventId}}/attendance"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!(pm.variables.get('attendanceToken') && pm.variables.get('fullEventId'))) {",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://eventia.jmacboy.dev/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "attendanceToken",
      "value": ""
    },
    {
      "key": "venueId",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "fullEventId",
      "value": ""
    }
  ]
}
